  "chapters": {
    "40953": {
      "reward": "加尼的垃圾堆",
      "lead": "按地图收尾，再回头查轮换任务",
      "steps": [
        "先展开奥迪尔、达萨罗之战等团本条目，按手册核对难度；把需要同伴的项目集中安排。",
        "在纳兹米尔、沃顿、斯托颂谷地分别清完当地小目标。遇到“狐人生活”或“天降正义”，先看对应的突袭或世界任务是否可用。"
      ],
      "source": "original"
    },
    "20501": {
      "reward": "佐瓦尔的噬魂者",
      "lead": "把盟约玩法和野外探索分开做",
      "steps": [
        "先查“暗影界爱好者”的缺项：灰烬王庭的宾客、忠诚试炼和憎恶缝合各有自己的进度。按缺项找 JAN-Z 对应的一集。",
        "单独开一趟扎雷殁提斯。对照“扎雷字母表”核对宝藏、冒险家、初诞者密文和开悟者；只跑自己还缺的项目。"
      ],
      "source": "original"
    },
    "19458": {
      "reward": "泰瓦恩",
      "lead": "从任务线、声望和世界事件三路推进",
      "steps": [
        "先核对巨龙群岛任务线与地下城。缺声望时，展开“天啊，他们是同巢胞友”，分别检查黑龙、工匠联盟、冬裘等阵营进度。",
        "去禁忌离岛前打开“偷尝禁果”，同一趟兼顾宝藏、卷轴和稀有。回到主岛后，按“穿越群岛”还缺的事件安排路线。"
      ],
      "source": "original"
    },
    "61451": {
      "reward": "磨轮号Mk. 11型",
      "lead": "把十项要求拆成地图行程",
      "steps": [
        "从“卡兹全家福”核对地图探索、魔符、剧情和土灵解锁。“心中有耀光”另看圣焰之耀名望，需要达到 10 级。",
        "海妖岛和卡雷什分开跑。做“解离与保护”时把卡雷什探索、宝藏和悬赏列在一起；团本部分另核对尼鲁巴尔王宫、解放安德麦和法力熔炉。"
      ],
      "source": "later"
    }
  },
